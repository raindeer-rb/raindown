#!/usr/bin/env ruby
# frozen_string_literal: true

# Bumps the minor version, like 0.7.0 to 0.8.0, or with --patch the patch version, like 0.7.0 to 0.7.1, and names the
# changelog's Unreleased changes after it, then runs bundle update, so Gemfile.lock has it too, and commits the version
# and the changelog as "Release v0.8.0", leaving any other changes out of it. Gemfile.lock isn't committed, as git
# ignores it.
#   bin/bump
#   bin/bump --patch

Dir.chdir(File.expand_path('..', __dir__))
path = 'lib/version.rb'
source = File.read(path)
version = source[/VERSION = '(\d+\.\d+\.\d+)'/, 1] or abort("There's no VERSION like '1.2.3' in #{path}")

major, minor, patch = version.split('.').map(&:to_i)
bumped = "#{major}.#{minor + 1}.0"
bumped = "#{major}.#{minor}.#{patch + 1}" if ARGV.include?('--patch')
File.write(path, source.sub("VERSION = '#{version}'", "VERSION = '#{bumped}'"))
puts "Bumped #{version} to #{bumped}"

changelog = File.read('CHANGELOG.md')
released = changelog.sub(/^## Unreleased$/, "## #{bumped}")
File.write('CHANGELOG.md', released)
files = [path]
files << 'CHANGELOG.md' unless released == changelog

system('bundle', 'update', exception: true)
system('git', 'commit', '-m', "Release v#{bumped}", '--', *files, exception: true)
